<!DOCTYPE html>
<html lang="{{ metadata.language }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="text-scale" content="scale" />
    <title>{{ title or metadata.title }} • Crinkles</title>
    <link
      rel="preload"
      href="/fonts/recursive-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="{{ '/styles/index.css' | url }}" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#f9fafb"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#111418"
    />
    <meta name="view-transition" content="same-origin" />
    <!-- seo -->
    <meta
      name="robots"
      content="{{ 'noindex,follow' if noindex else 'index,follow' }}"
    />
    <!-- assets -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- links -->
    <link
      rel="canonical"
      href="{{ canonical or (page.url | absoluteUrl(metadata.url)) }}"
    />
    <link rel="webmention" href="https://webmention.io/crinkles.dev/webmention" />
    <link rel="pingback" href="https://webmention.io/crinkles.dev/xmlrpc" />
    <link rel="me" href="https://indieweb.social/@crinkles" />
    <link rel="me" href="https://front-end.social/@crinkles" />
    <link
      rel="alternate"
      href="{{ metadata.feed.path | url }}"
      type="application/atom+xml"
      title="{{ metadata.title }}"
    />
    <!-- page data -->
    {%- set isPost = page.url.startsWith("/writing/") and page.url != "/writing/" %}
    <meta
      name="description"
      content="{{ description or metadata.description }}"
    />
    <meta name="author" content="{{ metadata.author.name }}" />
    <meta property="fediverse:creator" content="@crinkles@front-end.social" />
    <!-- OG -->
    <meta property="og:site_name" content="{{ metadata.site }}" />
    <meta property="og:type" content="{{ 'article' if isPost else 'website' }}" />
    <meta property="og:url" content="{{ page.url | absoluteUrl(metadata.url) }}" />
    <meta property="og:title" content="{{ title or metadata.title }}" />
    <meta
      property="og:description"
      content="{{ description or metadata.description }}"
    />
    <meta property="og:image" content="{{ metadata.social.img }}" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="{{ metadata.site }} — {{ metadata.title }}"
    />
    {%- if isPost %}
    <link
      rel="alternate"
      type="text/markdown"
      href="{{ ("/writing/" + page.fileSlug + ".md") | absoluteUrl(metadata.url) }}"
    />
    <meta property="article:published_time" content="{{ date | dateToRfc3339 }}" />
    <meta
      property="article:modified_time"
      content="{{ (update or date) | dateToRfc3339 }}"
    />
    {%- endif %}
    <!-- Opts into the large card on X/Discord; the rest falls back to og:* -->
    <meta name="twitter:card" content="summary_large_image" />
    {%- if isPost %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": {{ title | dump | safe }},
        "description": {{ (description or metadata.description) | dump | safe }},
        "url": "{{ page.url | absoluteUrl(metadata.url) }}",
        "datePublished": "{{ date | dateToRfc3339 }}",
        "dateModified": "{{ (update or date) | dateToRfc3339 }}",
        "author": {
          "@type": "Person",
          "name": {{ metadata.author.name | dump | safe }},
          "url": "{{ metadata.author.url }}"
        }
      }
    </script>
    {%- endif %}
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {% include "partials/header.njk" %}
    <main id="main" data-layout="{{ layout }}">{{ content | safe }}</main>
    {% include "partials/footer.njk" %}
    <div class="pattern"></div>
  </body>
  <!--{% set js %}{% include "scripts/sticky-footer.js" %}{% endset %}
    <script>{{ js | safe }}</script>-->
</html>

<!-- outputs all the icons used on the page -->
{% getBundle "fontawesome" %}
